generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  ORGANIZER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  TRANSFER_PENDING
  TRANSFERRED
  USED
  REVOKED
  EXPIRED
}

enum TransferStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
  REJECTED
}

enum ScanResult {
  VALID
  INVALID
  EXPIRED
  ALREADY_USED
  REVOKED
  REPLAY_DETECTED
}

// Sección física del recinto (IZQ, CTR, DER en el Auditorio ESCOM)
// Cada evento define sus propios precios por sección mediante EventSectionPrice
model VenueSection {
  id          String   @id @default(uuid())
  // Identificador corto usado en el mapa HTML: "IZQ" | "CTR" | "DER"
  code        String   @unique               // e.g. "IZQ", "CTR", "DER"
  label       String                         // e.g. "Izquierda", "Central", "Derecha"
  colorHex    String?                        // color visual en el mapa, e.g. "#7eb3bc"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seats              Seat[]
  eventSectionPrices EventSectionPrice[]

  @@map("venue_sections")
}

// Asiento físico del recinto — registro permanente, independiente de eventos
// id compuesto legible: "IZQ-A-01", "CTR-K-11", etc.
model Seat {
  id           String   @id                   // e.g. "CTR-B-05"
  sectionId    String
  row          String                          // "A" … "K"
  number       Int                            // 1 … 11
  seatLabel    String?                        // etiqueta display, e.g. "Fila B, Asiento 5"
  x            Float?                         // coordenada SVG x (para el mapa)
  y            Float?                         // coordenada SVG y (para el mapa)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  section      VenueSection @relation(fields: [sectionId], references: [id])
  tickets      Ticket[]

  @@index([sectionId])
  @@index([row])
  @@map("seats")
}

// Precio que el organizador fija para cada sección en un evento concreto
// Permite que el mismo recinto tenga precios distintos en cada evento
model EventSectionPrice {
  id          String   @id @default(uuid())
  eventId     String
  sectionId   String
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("MXN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section     VenueSection @relation(fields: [sectionId], references: [id])

  @@unique([eventId, sectionId])             // un precio por sección por evento
  @@index([eventId])
  @@map("event_section_prices")
}

model User {
  id                String       @id
  email             String       @unique
  fullName          String
  role              UserRole     @default(BUYER)
  emailVerified     Boolean      @default(false)
  phoneVerified     Boolean      @default(false)
  mfaEnabled        Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  publicKey   String? 

  profile           Profile?
  organizedEvents   Event[]      @relation("EventOrganizer")
  orders            Order[]
  ownedTickets      Ticket[]     @relation("TicketOwner")
  sentTransfers     Transfer[]   @relation("TransferSender")
  receivedTransfers Transfer[]   @relation("TransferRecipient")
  scansPerformed    ScanLog[]    @relation("ScannedByStaff")
  pushSubscriptions PushSubscription[]  

  @@map("users")
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  phone      String?
  avatarUrl  String?
  documentId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Event {
  id              String    @id @default(uuid())
  organizerId     String
  title           String
  description     String?
  venueName       String
  venueCity       String
  startsAt        DateTime
  endsAt          DateTime
  isPublished     Boolean   @default(false)
  useVenueMap  Boolean  @default(true)
  bannerUrl       String?
  category        String?                    // 'music' | 'theater' | 'sport' | 'festival' | 'other'
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizer           User                @relation("EventOrganizer", fields: [organizerId], references: [id])
  orders              Order[]
  tickets             Ticket[]
  ticketTypes         TicketType[]
  eventSectionPrices  EventSectionPrice[] // precios por sección definidos por el organizador

  @@index([organizerId])
  @@index([startsAt])
  @@map("events")
}

// TicketType se mantiene para compatibilidad con flujos sin asignación de asiento
// (e.g. acceso general sin asiento numerado)
model TicketType {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("MXN")
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id])
  tickets     Ticket[]

  @@index([eventId])
  @@map("ticket_types")
}

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  eventId         String
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  currency        String      @default("MXN")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer           User        @relation(fields: [buyerId], references: [id])
  event           Event       @relation(fields: [eventId], references: [id])
  tickets         Ticket[]

  @@index([buyerId])
  @@index([eventId])
  @@map("orders")
}

model Ticket {
  id                String       @id @default(uuid())
  eventId           String
  orderId           String
  ownerId           String

  // ── Asiento numerado (nuevo) ───────────────────────────────
  // Si seatId está presente, el boleto es para un asiento específico del mapa.
  // Si es null, el boleto es de acceso general (sin asiento asignado).
  seatId            String?      // FK → Seat.id  e.g. "CTR-B-05"

  // Campos denormalizados para lectura rápida sin join al mapa
  seatSection       String?      // "IZQ" | "CTR" | "DER"
  seatRow           String?      // "A" … "K"
  seatNumber        Int?         // 1 … 11
  seatLabel         String?      // "Fila B, Asiento 5"  (generado al crear)

  // ── Compatibilidad con flujo anterior ─────────────────────
  ticketType        String?      // nombre libre (legacy)
  ticketTypeId      String?      // FK → TicketType

  // ── Precio capturado al momento de la compra ──────────────
  // El precio viene de EventSectionPrice (asiento numerado)
  // o de TicketType.price (acceso general).
  price             Decimal      @db.Decimal(10, 2)
  currency          String       @default("MXN")

  status            TicketStatus @default(ACTIVE)
  issuedAt          DateTime     @default(now())
  usedAt            DateTime?
  revokedAt         DateTime?
  transferCount     Int          @default(0)
  dynamicTokenSeed  String?
  publicTokenKey    String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  event             Event        @relation(fields: [eventId], references: [id])
  order             Order        @relation(fields: [orderId], references: [id])
  owner             User         @relation("TicketOwner", fields: [ownerId], references: [id])
  seat              Seat?        @relation(fields: [seatId], references: [id])
  ticketTypeRef     TicketType?  @relation(fields: [ticketTypeId], references: [id])
  transfers         Transfer[]
  scanLogs          ScanLog[]

  @@unique([eventId, seatId])              // un boleto por asiento por evento
  @@index([eventId])
  @@index([orderId])
  @@index([ownerId])
  @@index([status])
  @@index([seatId])
  @@index([ticketTypeId])
  @@map("tickets")
}

model Transfer {
  id               String         @id @default(uuid())
  ticketId         String
  senderId         String
  recipientId      String
  status           TransferStatus @default(PENDING)
  initiatedAt      DateTime       @default(now())
  acceptedAt       DateTime?
  canceledAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  senderSignature    String? 
  recipientSignature String?
  payloadHash        String? 
  nonce                String?  
  recipientPayloadHash String?

  ticket           Ticket         @relation(fields: [ticketId], references: [id])
  sender           User           @relation("TransferSender", fields: [senderId], references: [id])
  recipient        User           @relation("TransferRecipient", fields: [recipientId], references: [id])

  @@index([ticketId])
  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@map("transfers")
}

model ScanLog {
  id               String      @id @default(uuid())
  ticketId         String
  scannedByUserId  String?
  gate             String?
  deviceId         String?
  scannedAt        DateTime    @default(now())
  result           ScanResult
  reason           String?
  requestNonce     String?
  tokenHash        String?

  ticket           Ticket      @relation(fields: [ticketId], references: [id])
  scannedBy        User?       @relation("ScannedByStaff", fields: [scannedByUserId], references: [id])

  @@index([ticketId])
  @@index([scannedByUserId])
  @@index([scannedAt])
  @@index([result])
  @@map("scan_logs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
